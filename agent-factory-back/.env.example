# Variables usadas por "Crear e iniciar proyecto" (automatización de scaffolding).
# No se leen contraseñas desde el frontend: se configuran únicamente acá.

# Conexión al PostgreSQL local donde se crean las bases de los proyectos nuevos.
SCAFFOLD_PG_HOST=localhost
SCAFFOLD_PG_PORT=5432
SCAFFOLD_PG_USER=postgres
SCAFFOLD_PG_PASSWORD=

# Puerto inicial de búsqueda para los backends/frontends generados.
# No deben ser 3001 ni 5173: esos pertenecen a Agent Factory.
SCAFFOLD_BACKEND_PORT_START=4001
SCAFFOLD_FRONTEND_PORT_START=4173

# Timeout (ms) para "npm install" en frontend/backend generados. Opcional.
SCAFFOLD_NPM_INSTALL_TIMEOUT_MS=300000
